rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)).data.enabled == true;
    }
    match /sitePages/tonhosolo {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['content', 'updatedAt', 'updatedBy']) &&
        request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /siteAdmins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
